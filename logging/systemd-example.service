[Unit]
Description=Perssua - AI-powered Audio Capture Service
Documentation=file:///path/to/perssua-app/logging/GUIDE.md
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=%u
Group=%u

# Data directory - customize if needed
Environment="PERSSUA_DATA_DIR=%h/.config/perssua"
Environment="PERSSUA_LOG_LEVEL=INFO"
Environment="PERSSUA_LOG_FORMAT=json"

# Execution
ExecStart=%h/.local/bin/perssua
Restart=on-failure
RestartSec=10

# Security hardening
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ReadWritePaths=%h/.config/perssua

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=perssua

# Resource limits (optional)
MemoryLimit=1G
CPUQuota=50%

[Install]
WantedBy=default.target
